<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Authors>Rob Lohmann</Authors>
		<Copyright>2022 - 2026</Copyright>
		<PackageIconUrl>https://github.com/roblohmann/CodeCube.ApplicationInsights.Extensions/blob/main/nuget-icon.png?raw=true</PackageIconUrl>
		<PackageProjectUrl>https://github.com/roblohmann/CodeCube.ApplicationInsights.Extensions</PackageProjectUrl>
		<RepositoryUrl>https://github.com/roblohmann/CodeCube.ApplicationInsights.Extensions</RepositoryUrl>
		<PackageTags>aspnetcore application insights cloudrolename cloudrole name</PackageTags>
		<Description>A collection of Telemetry Initializers to help you make better use of Application Insights.</Description>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
		<PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.16.0" />
	</ItemGroup>

</Project>